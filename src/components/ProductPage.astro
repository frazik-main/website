---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../content/site";
import { contactFormUrl, getCopy } from "../content/site";

interface Props {
  locale?: Locale;
  product: "sentinel";
}

const { locale = "en", product } = Astro.props;
const copy = getCopy(locale);
const content = copy.products[product];
---

<BaseLayout locale={locale} title={content.title} description={content.intro}>
  <article class="product-page">
    <header class="page-header service-hero">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p class="lead">{content.intro}</p>
      <div class="hero-actions">
        <a class="button" href={contactFormUrl} target="_blank" rel="noreferrer">{content.primaryCta} <span aria-hidden="true">→</span></a>
        <a class="text-link" href="/blog/2026/ai-vs-ai-local-defensive-appliance/">{content.secondaryCta}</a>
      </div>
    </header>

    <section class="service-grid">
      <div>
        <p class="eyebrow">{content.capabilitiesEyebrow}</p>
        <h2>{content.capabilitiesTitle}</h2>
      </div>
      <ul class="feature-list">
        {content.capabilities.map((capability) => <li>{capability}</li>)}
      </ul>
    </section>

    <section class="process-section">
      <div class="section-heading">
        <p class="eyebrow">{content.howEyebrow}</p>
        <h2>{content.howTitle}</h2>
      </div>
      <div class="process-grid four">
        {content.how.map(([number, title, text]) => <div class="process-card"><span>{number}</span><h3>{title}</h3><p>{text}</p></div>)}
      </div>
    </section>

    <section class="boundaries-section">
      <div>
        <p class="eyebrow">{content.honestEyebrow}</p>
        <h2>{content.honestTitle}</h2>
      </div>
      <ul class="feature-list">
        {content.honest.map((limitation) => <li>{limitation}</li>)}
      </ul>
    </section>

    <section class="callout" id="contact">
      <p class="eyebrow">{content.pilotEyebrow}</p>
      <h2>{content.pilotTitle}</h2>
      <p>{content.pilotText}</p>
      <a class="button" href={contactFormUrl} target="_blank" rel="noreferrer">{content.cta} <span aria-hidden="true">→</span></a>
    </section>
  </article>
</BaseLayout>
