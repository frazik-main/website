---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { sortPosts } from "../../lib/blog";

const posts = sortPosts(await getCollection("blog"));
---

<BaseLayout title="Cybersecurity, DevSecOps, and AI engineering" description="Practical notes on application security, DevSecOps, private AI, and responsible AI engineering.">
  <header class="page-header">
    <p class="eyebrow">Frazik · Engineering notes</p>
    <h1>Cybersecurity, DevSecOps, and AI engineering</h1>
    <p>Practical lessons for building and operating secure software—and adopting AI with care.</p>
  </header>
  <div class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
