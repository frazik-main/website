---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { sortPosts } from "../../lib/blog";

const posts = sortPosts(await getCollection("blog"));
---

<BaseLayout title="Blog" description="One Line of Code at a Time, Exploring the World Through Tech">
  <header class="page-header">
    <p class="eyebrow">Frazik blog</p>
    <h1>One Line of Code at a Time</h1>
    <p>Exploring the world through technology.</p>
  </header>
  <div class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
